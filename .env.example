# Copy to .env and replace all example secrets before deployment.
POSTGRES_DB=ai_ecosystem
POSTGRES_USER=ai_ecosystem
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
WEB_PORT=8080
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:8080

# Hosted OpenAI-compatible provider (leave key blank until configured)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Open-source local model runtime; install Ollama on the host or set a reachable URL.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
